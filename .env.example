# YouTube Script Chrome Extension Environment Variables

# Environment mode (development or production)
NODE_ENV=development

# Chrome extension configuration
CHROME_EXTENSION_ID=your_extension_id_here

# YouTube Data API (if needed for script features)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# API endpoints
VITE_API_BASE_URL=https://api.example.com

# Feature flags
VITE_ENABLE_LOGGING=false
VITE_ENABLE_DEBUG_MODE=false

# Third-party services (add as needed)
# VITE_ANALYTICS_KEY=your_analytics_key_here
